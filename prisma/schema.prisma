// Interiors by DeX CRM — Prisma Schema
// ORM: Prisma | DB: PostgreSQL via Supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
  // Uncomment directUrl before running prisma migrate on Supabase.
  // Use the "Session mode" pooler URL (port 5432) as DIRECT_URL.
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  DESIGNER
  CRE
  BL
  BRANCH_HEAD
}

enum LeadStage {
  EFFECTIVE_LEAD
  MQL
  DQL
  PROPOSAL_READY
  PROPOSAL_PRESENTED
  ONBOARDING
  HANDED_OVER
  INACTIVE
  ON_HOLD
}

enum CallOutcome {
  ANSWERED
  RNR_1
  RNR_2
  RNR_3
  RNR_4
  RNR_5
  CALLBACK
}

enum MeetingType {
  DQL
  PP
  ONBOARDING
  DESIGN_FREEZE
  SIGN_OFF
}

enum MeetingMode {
  EC_VISIT
  SITE_VISIT
  VIRTUAL
  PUBLIC_PLACE
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  RESCHEDULED
  NO_SHOW
}

enum DiscountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum PerformanceTier {
  BASIC
  STANDARD
  PREMIUM
}

enum AssignmentPath {
  STANDARD
  DIRECT
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  SELECT
}

enum LeadFileType {
  FLOOR_PLAN
  LIFESTYLE_CAPTURE
  PITCH_PRESENTATION
  QUOTATION
  GENERATED_QUOTE
  OTHER
}

enum ProjectPhase {
  DESIGN
  TECHNICAL
  PRODUCTION
  SITE_EXECUTION
  HANDOVER
  COMPLETED
}

enum ProjectHealth {
  ON_TRACK
  AT_RISK
  DELAYED
}

enum CollectionStatus {
  DUE
  INVOICED
  COLLECTED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id         String   @id @default(cuid())
  supabaseId String   @unique
  name       String
  email      String   @unique
  role       Role
  /// For Designers/CREs: the BL they report to
  blId       String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Performance metrics (recalculated nightly by performanceRecalc job)
  totalLeadsAssigned  Int             @default(0)
  totalLeadsConverted Int             @default(0)
  conversionRate      Float           @default(0)
  avgProjectValue     Decimal         @default(0) @db.Decimal(12, 2)
  performanceTier     PerformanceTier @default(BASIC)

  bl          User?  @relation("BLTeam", fields: [blId], references: [id])
  teamMembers User[] @relation("BLTeam")

  designerLeads Lead[] @relation("DesignerLeads")
  blLeads       Lead[] @relation("BLLeads")
  createdLeads  Lead[] @relation("CreatedLeads")

  callsLogged              Call[]
  followUpTasksAssigned    FollowUpTask[]
  discountRequestsRaised   DiscountRequest[] @relation("RequesterDiscounts")
  discountRequestsReviewed DiscountRequest[] @relation("ReviewerDiscounts")
  discountRequestsForwarded DiscountRequest[] @relation("ForwarderDiscounts")
  whatsappMessagesSent     WhatsAppMessage[]
  emailsPreviewed          EmailLog[]
  activityLogs             ActivityLog[]
  notifications            NotificationLog[]
  sentInvites              UserInvite[]      @relation("InvitedBy")
  intentRatingOverrides    IntentRatingLog[]
  designerProjects         Project[]
  uploadedFiles            LeadFile[]

  @@map("users")
}

model LeadCounter {
  id      Int @id @default(1)
  lastNum Int @default(0)

  @@map("lead_counter")
}

model ProjectCounter {
  id      Int @id @default(1)
  lastNum Int @default(0)

  @@map("project_counter")
}

model Lead {
  id                 String         @id @default(cuid())
  /// Auto-generated X#### format
  leadId             String         @unique
  name               String
  phone              String
  phone2             String?
  email              String?
  source             String?
  adName             String?
  utmCampaign        String?
  utmAdSet           String?
  utmSource          String?
  projectType        String?
  scope              String?
  location           String?
  possessionTimeline String?
  estimatedValue     Decimal?       @db.Decimal(12, 2)
  /// 1 (lowest intent) – 5 (highest intent)
  intentRating       Int?
  /// Scheduled next meeting date — required before moving to MQL
  nextMeetingDate    DateTime?
  /// Floor plan reference/URL — required before moving to PROPOSAL_READY
  floorPlanUrl       String?
  stage              LeadStage      @default(EFFECTIVE_LEAD)
  onHoldRevivalDate  DateTime?
  /// Reason for placing on hold — required when stage moves to ON_HOLD
  onHoldReason       String?
  /// Reason for marking inactive — required when stage moves to INACTIVE
  inactiveReason     String?
  /// Timestamp when the assigned designer first opened this lead's detail page
  firstOpenedAt      DateTime?
  isDuplicate        Boolean        @default(false)
  assignedDesignerId String?
  assignedBLId       String?
  createdById        String?
  currentOfferId     String?
  /// STANDARD = normal CRE→BL→Designer flow; DIRECT = BL manually assigned
  assignmentPath     AssignmentPath @default(STANDARD)
  /// Builder name or "N/A"
  builder            String?
  /// Client-specified offers / promotions (up to three)
  offer1             String?
  offer2             String?
  offer3             String?
  /// Expected move-in / possession date (calendar date)
  expectedMoveIn     DateTime?
  /// Alternate email ID
  email2             String?
  /// PAN number for invoicing
  pan                String?
  /// GST number for invoicing
  gst                String?
  /// Persistent lead-level notes (separate from activity log)
  notes              String?
  /// "auto" = set by meeting-mode mapping; "manual" = designer override
  intentRatingSource String?
  /// Flexible extra fields keyed by CustomFieldDefinition.key
  customFields       Json           @default("{}")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  assignedDesigner User?  @relation("DesignerLeads", fields: [assignedDesignerId], references: [id])
  assignedBL       User?  @relation("BLLeads", fields: [assignedBLId], references: [id])
  createdBy        User?  @relation("CreatedLeads", fields: [createdById], references: [id])
  currentOffer     Offer? @relation("CurrentOffer", fields: [currentOfferId], references: [id])

  /// Auto-calculated milestone durations in days
  daysLeadToDQL      Int?
  daysDQLToPP        Int?
  daysPPToOnboarding Int?
  isSLABreached      Boolean  @default(false)

  contacts             Contact[]
  calls                Call[]
  followUpTasks        FollowUpTask[]
  meetings             Meeting[]
  quotes               Quote[]
  discountRequests     DiscountRequest[]
  whatsappMessages     WhatsAppMessage[]
  emailLogs            EmailLog[]
  slaBreaches          SLABreach[]
  leadOffers           LeadOffer[]
  inactivationFeedback InactivationFeedback?
  activityLogs         ActivityLog[]
  notifications        NotificationLog[]
  smsLogs              SmsLog[]
  dqlQuestionnaire     DQLQuestionnaire?
  dipChecklist         DIPChecklist?
  intentRatingLogs     IntentRatingLog[]
  npsResponses         NPSResponse[]
  project              Project?
  leadFiles            LeadFile[]

  @@map("leads")
}

model Contact {
  id        String  @id @default(cuid())
  leadId    String
  name      String
  phone     String?
  email     String?
  isPrimary Boolean @default(false)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("contacts")
}

model Call {
  id                String      @id @default(cuid())
  leadId            String
  loggedById        String
  outcome           CallOutcome
  /// Duration in seconds
  duration          Int?
  notes             String?
  recordingUrl      String?
  /// Free-text agenda / purpose of the call
  agenda            String?
  /// Meeting location or context (e.g. "Office", "Client's site")
  location          String?
  /// Actual date-time of the call (may differ from log createdAt)
  calledAt          DateTime?
  /// JSON array of { type: string; fileUrl?: string } for call attachments
  attachments       Json?
  /// Planned next action after this call
  nextPlanOfAction  String?
  createdAt         DateTime    @default(now())

  lead     Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  loggedBy User @relation(fields: [loggedById], references: [id])

  @@map("calls")
}

model FollowUpTask {
  id           String    @id @default(cuid())
  leadId       String
  assignedToId String
  dueDate      DateTime
  /// HH:MM 24-hour format
  dueTime      String?
  isCompleted  Boolean   @default(false)
  isOverdue    Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  lead       Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo User @relation(fields: [assignedToId], references: [id])

  @@map("follow_up_tasks")
}

model Meeting {
  id                String        @id @default(cuid())
  leadId            String
  type              MeetingType
  /// For PP meetings: 1, 2, 3… tracked as PP1/PP2/PP3
  ppNumber          Int?
  mode              MeetingMode
  status            MeetingStatus @default(SCHEDULED)
  scheduledAt       DateTime
  rescheduledReason String?
  noShowReason      String?
  /// Minutes of Meeting — mandatory when status → COMPLETED
  mom               String?
  outcome           String?
  /// Physical / virtual location of the meeting
  location          String?
  /// Array of { scheduledAt, reason, rescheduledAt } — appended on every reschedule
  rescheduleHistory Json?
  confirmationSent  Boolean       @default(false)
  momSent           Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("meetings")
}

model Quote {
  id              String   @id @default(cuid())
  leadId          String
  /// Reference ID from proposals.interiorsbydex.com
  quoteBuilderRef String?
  amount          Decimal? @db.Decimal(12, 2)
  discountPct     Decimal? @db.Decimal(5, 2)
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now())

  lead             Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  discountRequests DiscountRequest[]

  @@map("quotes")
}

model DiscountRequest {
  id              String         @id @default(cuid())
  leadId          String
  quoteId         String?
  requestedById   String
  amount          Decimal        @db.Decimal(12, 2)
  originalAmount  Decimal        @db.Decimal(12, 2)
  discountPct     Decimal        @db.Decimal(5, 2)
  reason          String
  /// Woodwork value excluding GST
  woodworkValueExGst Decimal?    @db.Decimal(12, 2)
  /// Total project value excluding GST
  totalValueExGst    Decimal?    @db.Decimal(12, 2)
  /// Link to the quote (quote builder link or attachment URL)
  quoteLink          String?
  status          DiscountStatus @default(PENDING)
  /// Server-computed approval routing: SELF | BL | BRANCH_HEAD
  approverRole    String?
  /// True when discount > 20% OR post-discount woodwork value < ₹5,00,000
  isSpecialCase   Boolean        @default(false)
  reviewedById    String?
  /// Mandatory on rejection
  reviewerComment String?
  /// Set when BL forwards a BL-routed request to BRANCH_HEAD
  forwardedToRole String?
  /// The BL who forwarded the request
  forwardedById   String?
  createdAt       DateTime       @default(now())
  reviewedAt      DateTime?

  lead        Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  quote       Quote? @relation(fields: [quoteId], references: [id])
  requestedBy User   @relation("RequesterDiscounts", fields: [requestedById], references: [id])
  reviewedBy  User?  @relation("ReviewerDiscounts", fields: [reviewedById], references: [id])
  forwardedBy User?  @relation("ForwarderDiscounts", fields: [forwardedById], references: [id])

  @@map("discount_requests")
}

model WhatsAppMessage {
  id         String           @id @default(cuid())
  leadId     String
  direction  MessageDirection
  body       String
  templateId String?
  sentById   String?
  twilioSid  String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  lead   Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sentBy User? @relation(fields: [sentById], references: [id])

  @@map("whatsapp_messages")
}

model EmailLog {
  id            String   @id @default(cuid())
  leadId        String
  /// MEETING_CONFIRMATION | MOM | ONBOARDING | RNR_FOLLOWUP | NO_SHOW | INACTIVATION_FEEDBACK
  type          String
  sentTo        String
  subject       String
  sentAt        DateTime @default(now())
  previewedById String?

  lead        Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  previewedBy User? @relation(fields: [previewedById], references: [id])

  @@map("email_logs")
}

model SLABreach {
  id         String    @id @default(cuid())
  leadId     String
  /// FIRST_CONTACT | LEAD_TO_MQL | MQL_TO_DQL | PROPOSAL_TO_PP
  rule       String
  breachedAt DateTime  @default(now())
  resolvedAt DateTime?

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("sla_breaches")
}

model Offer {
  id          String    @id @default(cuid())
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  currentLeads Lead[]      @relation("CurrentOffer")
  leadOffers   LeadOffer[]

  @@map("offers")
}

model LeadOffer {
  id        String   @id @default(cuid())
  leadId    String
  offerId   String
  appliedAt DateTime @default(now())

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  offer Offer @relation(fields: [offerId], references: [id])

  @@map("lead_offers")
}

model InactivationFeedback {
  id                 String    @id @default(cuid())
  leadId             String    @unique
  reason             String
  formToken          String?   @unique
  feedbackFormSentAt DateTime?
  clientResponse     String?
  respondedAt        DateTime?

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("inactivation_feedback")
}

model ActivityLog {
  id        String   @id @default(cuid())
  leadId    String?
  userId    String
  action    String
  meta      Json?
  createdAt DateTime @default(now())

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  user User  @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([userId])
  @@map("activity_logs")
}

model ReportSchedule {
  id         String    @id @default(cuid())
  /// WEEKLY | MONTHLY
  type       String
  recipients String[]
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("report_schedules")
}

model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  /// OVERDUE_TASK | RNR_ESCALATION | DISCOUNT_REQUEST | SLA_BREACH | MEETING_NO_SHOW
  type      String
  message   String
  leadId    String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id])
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@map("notification_logs")
}

// ─── Gap-patch models ─────────────────────────────────────────────────────────

model SmsLog {
  id        String   @id @default(cuid())
  leadId    String?
  toPhone   String
  body      String
  twilioSid String?
  status    String   @default("queued")
  createdAt DateTime @default(now())

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@map("sms_logs")
}

model CustomFieldDefinition {
  id            String    @id @default(cuid())
  /// Unique slug key used in lead.customFields JSON (e.g. "carpet_area")
  key           String    @unique
  label         String
  fieldType     FieldType
  selectOptions Json?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  @@map("custom_field_definitions")
}

model IntentRatingConfig {
  /// 1–5 star rating
  rating      Int    @id
  label       String
  description String
  color       String @default("#6b7280")

  @@map("intent_rating_config")
}

model DQLQuestionnaire {
  id             String   @id @default(cuid())
  leadId         String   @unique
  formResponseId String?
  responses      Json     @default("{}")
  submittedAt    DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("dql_questionnaires")
}

model UserInvite {
  id          String    @id @default(cuid())
  email       String
  role        Role
  name        String
  invitedById String
  token       String    @unique @default(cuid())
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  invitedBy User @relation("InvitedBy", fields: [invitedById], references: [id])

  @@map("user_invites")
}

model LeadFile {
  id           String       @id @default(cuid())
  leadId       String
  stage        LeadStage
  fileType     LeadFileType
  fileName     String
  /// Supabase Storage path in private bucket crm-lead-files
  storagePath  String
  uploadedById String
  createdAt    DateTime     @default(now())

  lead       Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([leadId, stage])
  @@map("lead_files")
}

model DIPChecklist {
  id                       String    @id @default(cuid())
  leadId                   String    @unique
  welcomeMailSent          Boolean   @default(false)
  discountApprovalFormSent Boolean   @default(false)
  npsTriggered             Boolean   @default(false)
  cxApprovalReceived          Boolean   @default(false)
  internalMailThreadCompleted Boolean   @default(false)
  internalMailThreadUrl       String?
  completedAt              DateTime?
  createdAt                DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("dip_checklists")
}

model AssignmentConfig {
  id        String   @id @default(cuid())
  /// e.g. "premium_threshold_value", "standard_threshold_pct", "smart_assignment_enabled"
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("assignment_config")
}

// ─── Module 10 models ─────────────────────────────────────────────────────────

model SLAConfig {
  /// Rule key: FIRST_CONTACT_24H | LEAD_TO_MQL_5D | MQL_TO_DQL_5D | PROPOSAL_TO_PP_2D
  rule           String   @id
  thresholdHours Int
  updatedAt      DateTime @updatedAt

  @@map("sla_config")
}

model IntentRatingLog {
  id             String   @id @default(cuid())
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  systemRating   Int
  finalRating    Int
  overriddenById String?
  overriddenBy   User?    @relation(fields: [overriddenById], references: [id])
  reason         String?
  createdAt      DateTime @default(now())

  @@map("intent_rating_logs")
}

model NPSResponse {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  /// SALE | DESIGN | EXECUTION
  stage       String
  /// 0-10, null until responded
  score       Int?
  formToken   String    @unique
  /// Set only after email is successfully queued; null = email not yet sent (retryable)
  sentAt      DateTime?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([leadId, stage])
  @@map("nps_responses")
}

model Project {
  id                 String        @id @default(cuid())
  projectCode        String        @unique
  leadId             String        @unique
  lead               Lead          @relation(fields: [leadId], references: [id])
  designerId         String?
  designer           User?         @relation(fields: [designerId], references: [id])
  phase              ProjectPhase  @default(DESIGN)
  health             ProjectHealth @default(ON_TRACK)
  progressPercent    Int           @default(0)
  contractValue      Float
  outstandingAmount  Float         @default(0)
  location           String?
  handoverTargetDate DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  npsResponses  NPSResponse[]
  collections   Collection[]
  attentionFlags ProjectAttentionFlag[]

  @@map("projects")
}

model Collection {
  id          String           @id @default(cuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id])
  milestone   String
  amount      Float
  status      CollectionStatus @default(DUE)
  dueDate     DateTime?
  collectedAt DateTime?
  createdAt   DateTime         @default(now())

  @@map("collections")
}

model ProjectAttentionFlag {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  /// Delayed | At Risk | Blocked | Urgent service
  category    String
  description String
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@map("project_attention_flags")
}
